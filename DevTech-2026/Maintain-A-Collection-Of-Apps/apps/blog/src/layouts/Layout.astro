---
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <ClientRouter fallback="swap" />
    <link rel="icon" href="data:;base64,=" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="stylesheet"
      href="https://js.arcgis.com/calcite-components/5.0.0/main.css"
      transition:persist
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#212121" />
    <title>John Doe GIS Consulting</title>

    <style transition:persist>
      :root {
        color-scheme: dark;
      }

      html,
      body {
        background-color: var(--calcite-color-background, #212121);
        color: var(--calcite-color-text-1, #ffffff);
        height: 100%;
        margin: 0;
      }

      body {
        font-family:
          "Segoe UI",
          "Source Sans 3",
          system-ui,
          -apple-system,
          sans-serif;
      }

      .site-header {
        background: var(--calcite-color-foreground-1);
        border-bottom: 1px solid var(--calcite-color-border-2);
        color: var(--calcite-color-text-1);
        padding: 1.5rem;
      }

      .site-header__inner {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        gap: 0.25rem;
      }

      .site-title {
        font-size: 1.6rem;
        letter-spacing: 0.01em;
        text-decoration: none;
        color: inherit;
        font-weight: 600;
      }

      .home-page {
        display: grid;
        gap: 2.5rem;
        padding: 2rem 1.5rem 3rem;
        max-width: 1200px;
        margin: 0 auto;
      }

      .home-page .hero {
        display: grid;
        gap: 2rem;
        grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
        align-items: start;
      }

      .home-page .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.7rem;
        color: var(--calcite-color-text-2);
        margin: 0 0 0.75rem;
      }

      .home-page h1 {
        margin: 0 0 0.75rem;
        font-size: 2.2rem;
      }

      .home-page .lede {
        font-size: 1.05rem;
        margin: 0;
        color: var(--calcite-color-text-2);
      }

      .home-page .cta-row {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.25rem;
        flex-wrap: wrap;
      }

      .home-page .cta {
        background: var(--calcite-color-brand);
        color: #101010;
        padding: 0.6rem 1.2rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
      }

      .home-page .hero-panel {
        border: 1px solid var(--calcite-color-border-2);
        border-radius: 12px;
        padding: 1.25rem;
        background: var(--calcite-color-foreground-1);
      }

      .home-page .hero-title {
        margin: 0 0 0.5rem;
        font-weight: 600;
      }

      .home-page .hero-panel ul {
        margin: 0;
        padding-left: 1rem;
        color: var(--calcite-color-text-2);
        display: grid;
        gap: 0.4rem;
      }

      .home-page .blog h2 {
        margin: 0 0 0.5rem;
      }

      .home-page .post-list {
        display: grid;
        gap: 0.75rem;
        margin-top: 1rem;
      }

      .home-page .post-row {
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem;
        border-radius: 10px;
        border: 1px solid var(--calcite-color-border-2);
        background: var(--calcite-color-foreground-1);
        text-decoration: none;
        color: inherit;
      }

      .home-page .post-row h3 {
        margin: 0 0 0.35rem;
        font-size: 1.1rem;
      }

      .home-page .post-row p {
        margin: 0;
        color: var(--calcite-color-text-2);
      }

      .home-page .tag {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        background: var(--calcite-color-foreground-3);
        color: var(--calcite-color-text-1);
      }

      @media (max-width: 900px) {
        .home-page .hero {
          grid-template-columns: 1fr;
        }

        .home-page .post-row {
          flex-direction: column;
          align-items: flex-start;
        }
      }

    </style>
  </head>

  <body
    class="calcite-mode-dark"
    transition:persist
    style="background-color: #212121df;"
  >
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-title" href="/">John Doe GIS Consulting</a>
      </div>
    </header>
    <slot />
  </body>
</html>
